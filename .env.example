# WireGuard VPN Server Configuration
# cp .env.example .env && vim .env

# 서버 공인 IP 또는 도메인 (클라이언트가 접속할 주소)
WG_SERVERURL=your.domain.com

# WireGuard UDP 포트 (호스트 포트, 컨테이너 내부, nftables 룰 모두에 적용)
WG_SERVERPORT=51820

# 최초 생성할 peer 수 (추후 늘리려면 이 값을 변경 후 재기동)
WG_PEERS=1

# 피어 DNS 서버 (iOS 안정성을 위해 반드시 명시)
WG_PEERDNS=1.1.1.1,8.8.8.8

# WireGuard 내부망 서브넷 (예: 10.8.0.0 → 10.8.0.0/24)
WG_INTERNAL_SUBNET=10.8.0.0

# 허용 IP 대역
# Full tunnel (모든 트래픽 VPN 통과) → 0.0.0.0/0,::/0
# Split tunnel (내부망만)                → 10.8.0.0/24
WG_ALLOWEDIPS=0.0.0.0/0,::/0

# NAT 뒤 모바일 기기 연결 유지를 위한 PersistentKeepalive (초)
# 0 = 비활성화, 25 = 권장
WG_KEEPALIVE=25
