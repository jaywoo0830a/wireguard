# WireGuard VPN Server Configuration
# cp .env.example .env && vim .env

# Server public IP or domain (clients connect to this address)
WG_SERVERURL=your.domain.com

# WireGuard UDP port (applied to host port, container, and nftables rules)
WG_SERVERPORT=51820

# Initial number of peers to create (increase and restart to add more)
WG_PEERS=10

# Peer DNS servers (explicitly set for iOS stability)
WG_PEERDNS=1.1.1.1,8.8.8.8

# WireGuard internal subnet (e.g. 10.8.0.0 → 10.8.0.0/24)
WG_INTERNAL_SUBNET=10.8.0.0

# Allowed IP ranges
# Full tunnel (all traffic through VPN) → 0.0.0.0/0,::/0
# Split tunnel (internal only)           → 10.8.0.0/24
WG_ALLOWEDIPS=0.0.0.0/0,::/0

# Persistent keepalive in seconds for NAT-traversal (mobile devices)
# 0 = disabled, 25 = recommended
WG_KEEPALIVE=25
